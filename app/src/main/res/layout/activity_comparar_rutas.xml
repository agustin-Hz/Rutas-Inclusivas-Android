<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compararRutasRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Encabezado -->
        <TextView
            android:id="@+id/tvTituloRutas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="‹   Resumen de ruta"
            android:textColor="#123B70"
            android:textSize="23sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <!-- Origen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desde:"
            android:textColor="#53657D"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvOrigen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi ubicación"
            android:textColor="#123B70"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- Destino -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hasta:"
            android:textColor="#53657D"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destino seleccionado"
            android:textColor="#123B70"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <!-- Información de la ruta -->
        <LinearLayout
            android:id="@+id/cardRutaRecomendada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="18dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ruta recomendada"
                android:textColor="#123B70"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoAccesibilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Calculando accesibilidad..."
                android:textColor="#0866D9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#E3EAF3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distancia"
                android:textColor="#53657D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDistanciaRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- km"
                android:textColor="#123B70"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duración estimada"
                android:textColor="#53657D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDuracionRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- min"
                android:textColor="#123B70"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Obstáculos registrados"
                android:textColor="#53657D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCantidadObstaculos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#D97706"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/tvMensajeRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Información de accesibilidad"
                android:textColor="#53657D"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Botón para volver al mapa -->
        <Button
            android:id="@+id/btnVerMapa"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Ver ruta en el mapa"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#0866D9" />

    </LinearLayout>

</ScrollView>
