<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F4F7FC"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalles del reporte"
            android:textColor="#123B70"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de obstáculo"
            android:textColor="#123B70"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetalleTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF7900"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#123B70"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#263238"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado"
            android:textColor="#123B70"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetalleEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#263238"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha y hora"
            android:textColor="#123B70"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetalleFechaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#263238"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textColor="#123B70"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetalleUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#263238"
            android:textSize="16sp"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/btnValidarReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Validar reporte"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0866D9" />

        <Button
            android:id="@+id/btnCerrarDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textColor="#123B70"
            android:backgroundTint="#DCEBFF" />

    </LinearLayout>

</ScrollView>
