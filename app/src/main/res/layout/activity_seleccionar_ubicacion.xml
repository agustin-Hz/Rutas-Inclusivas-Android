<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapSeleccionUbicacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botón para regresar a la búsqueda -->
    <Button
        android:id="@+id/btnVolverBusqueda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="← Volver a búsqueda" />

    <!-- Indicador del centro del mapa -->
    <TextView
        android:id="@+id/miraUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="⊕"
        android:textSize="44sp"
        android:textColor="#1565C0" />

    <!-- Confirmación de la ubicación -->
    <Button
        android:id="@+id/btnConfirmarUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:text="Confirmar ubicación" />

</FrameLayout>
