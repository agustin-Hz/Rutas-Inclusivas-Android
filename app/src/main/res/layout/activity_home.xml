<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F4F7FC"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    tools:context=".HomeActivity">


    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#123B70"
        android:textSize="27sp"
        android:textStyle="bold"
        android:accessibilityHeading="true"
        tools:text="Hola, maria_g" />

    <TextView
        android:id="@+id/tvDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#526780"
        android:textSize="14sp"
        tools:text="maria@correo.com · General Pacheco" />

    <!-- Título de la sección del mapa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mapa de accesibilidad"
            android:textColor="#123B70"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Explorá tu entorno y encontrá obstáculos urbanos"
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Agregue esta tarjeta que es donde va a estar contenido el mapa -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:minHeight="180dp"
        android:background="@drawable/bg_mapa_card"
        android:clipToOutline="true"
        android:elevation="3dp">

        <!-- Esta es la vista del mapa -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Explorar mapa"
            android:textColor="#123B70"
            android:textSize="12sp"
            android:textStyle="bold" />

    </FrameLayout>




    <!-- Accesos rápidos del Home -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <!-- Buscar destino -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnBuscarDestinoHome"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_buscar_destino"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:contentDescription="Buscar destino"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Buscar destino"
                android:textColor="#123B70"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Reportar obstáculo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnReportarHome"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_reportar_obstaculo"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:contentDescription="Reportar obstáculo"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Reportar obstáculo"
                android:textColor="#123B70"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Configurar accesibilidad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnAccesibilidadHome"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_accesibilidad_home"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:contentDescription="Configurar accesibilidad"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Accesibilidad"
                android:textColor="#123B70"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/cerrar_sesion"
        android:textColor="#0755A6"
        android:textSize="14sp"
        android:backgroundTint="#DCEBFF" />




</LinearLayout>