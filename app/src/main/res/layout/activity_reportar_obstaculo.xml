<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reportarObstaculoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#0866D9">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reportar obstáculo"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ayudanos a mejorar la accesibilidad de las calles."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Tipo de obstáculo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tipo de obstáculo"
            android:textColor="#123B70"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTipoObstaculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0866D9"
            android:minHeight="48dp" />

        <!-- Ubicación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Ubicación del obstáculo"
            android:textColor="#123B70"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSeleccionarEnMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Seleccionar ubicación en el mapa"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0866D9" />

        <Button
            android:id="@+id/btnMiUbicacionReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Usar mi ubicación actual"
            android:textColor="#0755A6"
            android:backgroundTint="#DCEBFF" />

        <TextView
            android:id="@+id/tvUbicacionReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:text="Todavía no seleccionaste una ubicación"
            android:textColor="#123B70"
            android:background="#DCEBFF"
            android:textSize="14sp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Descripción"
            android:textColor="#123B70"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcionReporte"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0866D9"
            android:gravity="top|start"
            android:hint="Describí el obstáculo..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:textColor="#123B70"
            android:textColorHint="#7A8CA5" />

        <Button
            android:id="@+id/btnDictarDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dictar descripción"
            android:textColor="#0755A6"
            android:backgroundTint="#DCEBFF" />

        <!-- Enviar -->
        <Button
            android:id="@+id/btnEnviarReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:padding="12dp"
            android:text="Enviar reporte"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF7900" />

    </LinearLayout>

</ScrollView>
